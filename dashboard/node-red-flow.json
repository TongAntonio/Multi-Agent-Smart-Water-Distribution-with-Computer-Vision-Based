[
  {
    "id": "tab1",
    "type": "tab",
    "label": "Smart Water Agents",
    "disabled": false,
    "info": "Fig. 9 dashboard: MQTT -> Node-RED"
  },
  {
    "id": "broker",
    "type": "mqtt-broker",
    "name": "Mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "nodered-dashboard",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "ui_tab",
    "type": "ui_tab",
    "name": "Water Network",
    "icon": "water_drop",
    "order": 1
  },
  {
    "id": "g_water",
    "type": "ui_group",
    "name": "Tank level (L)",
    "tab": "ui_tab",
    "order": 1,
    "disp": true,
    "width": "6"
  },
  {
    "id": "g_queue",
    "type": "ui_group",
    "name": "Queue length",
    "tab": "ui_tab",
    "order": 2,
    "disp": true,
    "width": "6"
  },
  {
    "id": "g_fc",
    "type": "ui_group",
    "name": "Forecast demand (requests / 5 min)",
    "tab": "ui_tab",
    "order": 3,
    "disp": true,
    "width": "6"
  },
  {
    "id": "mqtt_in",
    "type": "mqtt in",
    "z": "tab1",
    "name": "agent state",
    "topic": "water/agents/+/state",
    "qos": "0",
    "datatype": "json",
    "broker": "broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 140,
    "wires": [
      [
        "split"
      ]
    ]
  },
  {
    "id": "split",
    "type": "function",
    "z": "tab1",
    "name": "split fields per agent",
    "func": "const id = msg.topic.split('/')[2];\nconst p = msg.payload;\nreturn [\n  {topic: 'agent ' + id, payload: Math.round(p.water_ml / 10) / 100},\n  {topic: 'agent ' + id, payload: p.queue_len},\n  {topic: 'agent ' + id, payload: p.forecast}\n];",
    "outputs": 3,
    "noerr": 0,
    "x": 360,
    "y": 140,
    "wires": [
      [
        "c_water"
      ],
      [
        "c_queue"
      ],
      [
        "c_fc"
      ]
    ]
  },
  {
    "id": "c_water",
    "type": "ui_chart",
    "z": "tab1",
    "name": "Water (L)",
    "group": "g_water",
    "order": 1,
    "width": 0,
    "height": 0,
    "label": "Water (L)",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "waiting for agents",
    "dot": false,
    "ymin": "0",
    "ymax": "",
    "removeOlder": 1,
    "removeOlderPoints": "",
    "removeOlderUnit": "3600",
    "cutout": 0,
    "useOneColor": false,
    "useUTC": false,
    "outputs": 1,
    "x": 620,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "c_queue",
    "type": "ui_chart",
    "z": "tab1",
    "name": "Queue",
    "group": "g_queue",
    "order": 1,
    "width": 0,
    "height": 0,
    "label": "Queue",
